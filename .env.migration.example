# ============================================================================
# SUPABASE MIGRATION CONFIGURATION
# ============================================================================

# SOURCE DATABASE - Original AI-Range Database
# Format: postgresql://user:password@host:port/database
SOURCE_SUPABASE_URL=postgresql://postgres:YOUR_SOURCE_PASSWORD@db.source.supabase.co:5432/postgres

# TARGET DATABASE - New Consolidated Database
# Format: postgresql://user:password@host:port/database
TARGET_SUPABASE_URL=postgresql://postgres:YOUR_TARGET_PASSWORD@db.target.supabase.co:5432/postgres

# ============================================================================
# SCHEMA DEPLOYMENT CONFIGURATION (for reference)
# ============================================================================

# SUPABASE_HOST=db.aayinvrvtumndpubwtui.supabase.co
# SUPABASE_PORT=5432
# SUPABASE_USER=postgres
# SUPABASE_PASSWORD=YOUR_PASSWORD_HERE
# SUPABASE_DB=postgres
# SCHEMA_PATH=sql/schemas/schema_complete.sql

# ============================================================================
# NOTES
# ============================================================================
# 1. Replace YOUR_SOURCE_PASSWORD and YOUR_TARGET_PASSWORD with actual credentials
# 2. Source database URL should point to the original AI-Range database
# 3. Target database URL should point to the new consolidated database
# 4. Ensure both databases are accessible and target schema is deployed
# 5. For special characters in password, URL encode them:
#    ! → %21, @ → %40, # → %23, $ → %24, etc.
# ============================================================================
