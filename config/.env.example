# Example environment file for uploading SQL to an AWS Aurora (Postgres) cluster.
# Copy to `.env` (or load with your preferred dotenv loader) and fill in values.

# Aurora connection
AURORA_HOST=your-cluster.cluster-xxxxxxxxxxxx.us-east-1.rds.amazonaws.com
AURORA_DB=your_database_name
AURORA_USER=your_db_user
AURORA_PORT=5432

# Postgres password (or use AWS Secrets Manager and leave this empty)
# If you use this file directly, keep it out of version control.
PGPASSWORD=your_db_password

# Optional: SSL mode for psql (disable|require|verify-ca|verify-full)
# Use 'require' for encrypted connections if the cluster enforces SSL.
PGSSLMODE=disable

# Optional: If using RDS Data API / Secrets Manager (serverless), provide ARNs
# Leave blank if not using Data API.
AWS_REGION=us-east-1
RDS_DATA_API_SECRET_ARN=
RDS_DATA_API_RESOURCE_ARN=

# Usage examples (do NOT commit real credentials):
#   export $(cat .env | xargs)
#   chmod +x scripts/upload_to_aurora.sh && ./scripts/upload_to_aurora.sh
